{
  "name": "parnian-cosmetics",
  "version": "0.1.0",
  "private": true,
  "description": "RTL-first Persian premium cosmetics site — static export for GitHub Pages",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "postbuild": "node scripts/flatten-rsc-payloads.mjs",
    "preview": "node scripts/serve-static.mjs --port 4321",
    "preview:pages": "node scripts/serve-static.mjs --port 4321 --base parnian-cosmetics",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/generate-media.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
